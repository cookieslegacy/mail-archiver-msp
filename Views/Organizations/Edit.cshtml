@model MailArchiver.Models.Organization
@{
    ViewData["Title"] = Model.Name;
    var admins = (List<MailArchiver.Controllers.OrganizationAdminRow>)ViewBag.Admins;
    var unassigned = (List<MailArchiver.Controllers.OrganizationAdminRow>)ViewBag.Unassigned;
    var packages = (List<MailArchiver.Models.Package>)ViewBag.Packages;
    var quota = (MailArchiver.Services.Organizations.QuotaStatus)ViewBag.Quota;
    var mailAccounts = (List<MailArchiver.Controllers.OrganizationMailAccountRow>)ViewBag.MailAccounts;
    string Size(long bytes) => bytes >= 1L << 30 ? $"{bytes / (double)(1L << 30):N2} GB" : $"{bytes / (double)(1L << 20):N1} MB";
    string Gb(long? bytes) => bytes is long b ? Math.Round(b / (decimal)(1L << 30), 2).ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
}
<div class="container" style="max-width: 960px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-building me-2"></i>@Model.Name <small class="text-muted"><code>@Model.Slug</code></small></h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@CL["Back"]</a>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light">@CL["Organization"]</div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">@CL["Name"]</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmailDomains" class="form-label">@CL["Domains"]</label>
                        <input asp-for="EmailDomains" class="form-control" />
                        <div class="form-text">@CL["DomainsHelp"]</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">@CL["Notes"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">@CL["ActiveHelp"]</label>
                    </div>
                </div>
                <div class="mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@CL["Save"]</button></div>
            </form>
            <hr />
            <div class="small text-muted">
                @CL["Retention"]: @CL["YearsValue", Model.RetentionYears]
                &middot; @CL["LegalHold"]: @(Model.LegalHold ? CL["Yes"] : CL["No"])
                &middot; @CL["SupportAccess"]: @(Model.AllowProviderAccess ? CL["Allowed"] : CL["NotAllowed"])
                <div>@CL["OrganizationSettingsOwnedByCustomer"]</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light">@CL["PackageAndStorage"]</div>
        <div class="card-body">
            <div class="mb-3"><partial name="_QuotaBar" model="quota" /></div>
            <div class="small text-muted mb-3">
                @CL["MailAccounts"]: @quota.MailAccounts@(quota.MaxMailAccounts is int max ? $" / {max}" : "")
                &middot; @CL["OriginalsShare"]: @Size(quota.OriginalBytes)
            </div>
            <form asp-action="SetPackage" asp-route-id="@Model.Id" method="post" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="packageId">@CL["Package"]</label>
                    <select class="form-select" id="packageId" name="packageId">
                        <option value="">@CL["NoPackage"]</option>
                        @foreach (var p in packages)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.PackageId)">@p.Name@(p.IsActive ? "" : " (" + CL["Inactive"].Value + ")")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="storageQuotaGb">@CL["StorageQuotaOverride"]</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" class="form-control" id="storageQuotaGb" name="storageQuotaGb" value="@Gb(Model.StorageQuotaBytes)" placeholder="@CL["FromPackage"]" />
                        <span class="input-group-text">GB</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="maxMailAccounts">@CL["MaxMailAccountsOverride"]</label>
                    <input type="number" min="0" class="form-control" id="maxMailAccounts" name="maxMailAccounts" value="@Model.MaxMailAccounts" placeholder="@CL["FromPackage"]" />
                </div>
                <div class="col-12 form-text mt-1">@CL["OverrideHelp"]</div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@CL["Save"]</button></div>
            </form>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span>@CL["MailAccounts"]</span>
            <form asp-action="EnterManagement" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-primary" title="@CL["ManageMailAccountsHelp"]">
                    <i class="bi bi-inboxes me-1"></i>@CL["ManageMailAccounts"]
                </button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>@CL["Name"]</th>
                        <th>@CL["Type"]</th>
                        <th>@CL["Status"]</th>
                        <th>@CL["LastSync"]</th>
                        <th class="text-end">@CL["Emails"]</th>
                        <th class="text-end">@CL["Storage"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in mailAccounts)
                    {
                        <tr>
                            <td>@a.Name<div class="small text-muted">@a.EmailAddress</div></td>
                            <td class="small">@a.Provider</td>
                            <td>@if (a.IsEnabled) { <span class="badge bg-success">@CL["Active"]</span> } else { <span class="badge bg-secondary">@CL["Inactive"]</span> }</td>
                            <td class="small">@(a.LastSync.Year <= 1970 ? "–" : a.LastSync.ToLocalTime().ToString("g"))</td>
                            <td class="text-end">@a.Emails.ToString("N0")</td>
                            <td class="text-end">@Size(a.StorageBytes)</td>
                        </tr>
                    }
                    @if (!mailAccounts.Any())
                    {
                        <tr><td colspan="6" class="text-muted">@CL["NoMailAccounts"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-light">@CL["OrganizationAdmins"]</div>
        <div class="card-body">
            <table class="table table-sm">
                <thead><tr><th>@CL["Username"]</th><th>@CL["Email"]</th><th>@CL["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var a in admins)
                    {
                        <tr>
                            <td>@a.Username @if (a.IsOidc) { <span class="badge bg-info">OIDC</span> }</td>
                            <td>@a.Email</td>
                            <td>@(a.IsActive ? CL["Active"] : CL["Inactive"])</td>
                        </tr>
                    }
                    @if (!admins.Any())
                    {
                        <tr><td colspan="3" class="text-muted">@CL["NoAdmins"]</td></tr>
                    }
                </tbody>
            </table>
            <p class="small text-muted">@CL["CreateAdminHelp"]</p>
            <form asp-action="CreateAdmin" asp-route-id="@Model.Id" method="post" class="row g-2">
                <div class="col-md-4"><input name="username" class="form-control" placeholder="@CL["Username"]" required autocomplete="off" /></div>
                <div class="col-md-4"><input name="email" type="email" class="form-control" placeholder="@CL["Email"]" autocomplete="off" /></div>
                <div class="col-md-3"><input name="password" type="password" class="form-control" placeholder="@CL["Password"]" minlength="12" required autocomplete="new-password" /></div>
                <div class="col-md-1"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-person-plus"></i></button></div>
            </form>
        </div>
    </div>

    @if (unassigned.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-light">@CL["UnassignedUsers"]</div>
            <div class="card-body">
                <p class="small text-muted">@CL["UnassignedUsersHelp"]</p>
                <table class="table table-sm mb-0">
                    @foreach (var u in unassigned)
                    {
                        <tr>
                            <td>@u.Username</td>
                            <td>@u.Email</td>
                            <td class="text-end">
                                <form asp-action="AssignUser" asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@CL["AssignToOrganization"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    }
</div>
